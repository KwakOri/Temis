{
  "cSpell.words": [
    "Ansungtangmyun",
    "Daelong",
    "dohwabi",
    "okshu",
    "Omakase",
    "Ongleeb",
    "Onglipp",
    "polagom",
    "ruhee",
    "rumency",
    "serah",
    "supabase",
    "Unpurchased",
    "yanz"
  ],
  "kiroAgent.agentAutonomy": "Autopilot",
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  // 변경된 줄만 포맷해서 레거시 파일이 통째로 재포맷되는 걸 막는다. 다만
  // git 기준선이 없는 신규 파일은 전체 포맷으로 자동 폴백한다.
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "prettier.requireConfig": true,
  // organize-imports on save가 import 블록을 통째로 재정렬하면서 무관한 diff를
  // 만들고, jsx "preserve" 환경에서 필요한 React import까지 제거해 체크
  // 스크립트를 깨뜨렸다. 정렬은 Prettier에 맡기고 이 액션은 끈다.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
