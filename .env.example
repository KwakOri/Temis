# JWT Secret Key for authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://ajlgjdwkjyayrnocdfpj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Required only by privileged server routes. Never use a NEXT_PUBLIC_ prefix.
# Keep the real value only in ignored env files such as `.env.remote.local`.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used by `npm run dev:local -- --dump` to clone remote data into local Supabase.
# Recommended auth: set SB token or SUPABASE_ACCESS_TOKEN, then linked project dump is used.
SB_TOKEN_TEMIS=sbp_xxx...
SUPABASE_PROJECT_REF=ajlgjdwkjyayrnocdfpj
# Optional: direct DB URL mode (if provided, this is used instead of linked mode).
# SUPABASE_REMOTE_DB_URL=postgresql://postgres:your-percent-encoded-password@db.ajlgjdwkjyayrnocdfpj.supabase.co:5432/postgres?sslmode=require
# Optional comma-separated schema list for remote data dump.
SUPABASE_REMOTE_DUMP_SCHEMAS=public,auth,storage

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Data Structure Version
# Increment this version when data structure changes to force localStorage reset
NEXT_PUBLIC_DATA_VERSION=1.0.0

# Twitter API (for Twitter integration)
# Get these from your Twitter Developer Portal (https://developer.twitter.com)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_CALLBACK_URL=http://localhost:3000/api/auth/twitter/callback

# Cloudflare R2 Configuration
# Get these from your Cloudflare R2 dashboard
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
# Template Studio local/dev R2 prefixes. Keep these scoped so cleanup can avoid unrelated assets.
TEMPLATE_STUDIO_PREVIEW_R2_BASE_PREFIX=uploads/dev/template-studio-preview
TEMPLATE_STUDIO_ASSET_R2_BASE_PREFIX=template-studio/dev
